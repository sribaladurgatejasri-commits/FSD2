<!doctype html><html><head><title>CampusCare Login</title><style>body{font-family:Arial;background:#eef2ff}.card{width:380px;margin:90px auto;background:white;padding:35px;border-radius:15px;box-shadow:0 8px 25px #bbb}h1{color:#4f46e5}input,button{width:100%;padding:12px;margin:10px 0;box-sizing:border-box;border-radius:7px}input{border:1px solid #ddd}button{border:0;background:#4f46e5;color:white;font-weight:bold}.msg{text-align:center}</style></head><body><div class="card"><h1>CampusCare</h1><h2>Login</h2><%if(request.getParameter("registered")!=null){%><p class="msg">Registration successful. Please login.</p><%}%><%if(request.getParameter("error")!=null){%><p class="msg">Invalid login details.</p><%}%><form action="login" method="post"><input name="username" placeholder="Email / admin" required><input type="password" name="password" placeholder="Password" required><button>LOGIN</button></form><p>New student? <a href="register.jsp">Register</a></p></div></body></html>