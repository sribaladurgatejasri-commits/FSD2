<%@page import="java.util.List,com.campuscare.dao.ComplaintDAO,com.campuscare.model.Complaint"%><%String role=(String)session.getAttribute("adminRole");if(role==null){response.sendRedirect("admin-login.jsp");return;}List<Complaint> list=new ComplaintDAO().adminList(role);%><!doctype html><html><head><title>Complaint Admin</title><style>body{font-family:Arial;background:#f5f6fa;margin:0}.nav{background:#111827;color:white;padding:18px}.wrap{max-width:1000px;margin:25px auto}.card{background:white;padding:20px;margin:15px 0;border-radius:10px}select,textarea,button{width:100%;padding:10px;margin:6px 0;box-sizing:border-box}button{background:#4f46e5;color:white;border:0;border-radius:6px}</style></head><body><div class="nav">CampusCare Complaint Admin | Role: <%=role%></div><div class="wrap"><p><b>Privacy:</b> Student name, roll number, email and phone are intentionally hidden.</p><%for(Complaint c:list){%><div class="card"><h3>Complaint #<%=c.getComplaintId()%> - <%=c.getTitle()%></h3><p>Category: <%=c.getCategoryName()%></p><p><%=c.getDescription()%></p><p>Location: <%=c.getLocation()%></p><p>Priority: <%=c.getPriority()%></p><p>Status: <b><%=c.getStatus()%></b></p><form action="updateComplaint" method="post"><input type="hidden" name="complaintId" value="<%=c.getComplaintId()%>"><select name="status"><option>Submitted</option><option>In Progress</option><option>Resolved</option><option>Rejected</option></select><textarea name="remarks" placeholder="Remarks"></textarea><button>UPDATE STATUS</button></form></div><%}%></div></body></html>