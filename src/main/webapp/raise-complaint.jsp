<%if(session.getAttribute("studentId")==null){response.sendRedirect("login.jsp");return;}%><!doctype html><html><head><title>Raise Complaint</title><style>body{font-family:Arial;background:#eef2ff}.card{max-width:650px;margin:40px auto;background:white;padding:30px;border-radius:15px}input,select,textarea,button{width:100%;padding:12px;margin:7px 0 15px;box-sizing:border-box;border-radius:7px}input,select,textarea{border:1px solid #ddd}button{border:0;background:#4f46e5;color:white;font-weight:bold}</style></head><body><div class="card"><h1>Raise Campus Complaint</h1><p><b>Privacy:</b> Your roll number and identity are not shown to the responsible complaint admin.</p><%if(request.getParameter("error")!=null){%><p>Complaint could not be submitted.</p><%}%><form action="complaint" method="post"><label>Category</label><select name="category" required><option value="">Select</option><option>Hostel</option><option>Canteen</option><option>Classroom</option><option>Laboratory</option><option>Transport</option><option>Library</option><option>Maintenance</option><option>Security</option></select><label>Title</label><input name="title" required><label>Description</label><textarea name="description" rows="6" required></textarea><label>Location</label><input name="location"><label>Priority</label><select name="priority"><option>Low</option><option selected>Medium</option><option>High</option><option>Urgent</option></select><button>SUBMIT COMPLAINT</button></form></div></body></html>