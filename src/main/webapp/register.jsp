<!doctype html><html><head><title>CampusCare Registration</title><style>body{font-family:Arial;background:#eef2ff}.card{max-width:600px;margin:40px auto;background:white;padding:35px;border-radius:15px;box-shadow:0 8px 25px #bbb}input,select,button{width:100%;padding:11px;margin:7px 0 15px;box-sizing:border-box;border-radius:7px}input,select{border:1px solid #ddd}button{border:0;background:#4f46e5;color:white;font-weight:bold}.error{color:#b91c1c}</style></head><body><div class="card"><h1>Student Registration</h1><%if(request.getParameter("error")!=null){%><p class="error">Registration failed. Roll number or email may already exist.</p><%}%><form action="register" method="post"><label>Roll Number</label><input name="rollNo" required><label>Name</label><input name="name" required><label>Email</label><input type="email" name="email" required><label>Phone</label><input name="phone"><label>Department</label><input name="department" required><label>Year</label><select name="yearNo" required><option value="">Select</option><option>1</option><option>2</option><option>3</option><option>4</option></select><label>Password</label><input type="password" name="password" required><button>CREATE ACCOUNT</button></form><a href="login.jsp">Back to Login</a></div></body></html>