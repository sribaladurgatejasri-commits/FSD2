<%@page import="java.util.List,com.campuscare.dao.ComplaintDAO,com.campuscare.model.Complaint"%><%if(session.getAttribute("studentId")==null){response.sendRedirect("login.jsp");return;}List<Complaint> list=new ComplaintDAO().studentList((Integer)session.getAttribute("studentId"));%><!doctype html><html><head><title>Student Dashboard</title><style>body{font-family:Arial;background:#f5f6fa;margin:0}.nav{background:#4f46e5;color:white;padding:18px}.wrap{max-width:950px;margin:25px auto}.card{background:white;padding:20px;margin:15px 0;border-radius:10px}.btn{background:#4f46e5;color:white;padding:11px 18px;text-decoration:none;border-radius:7px}</style></head><body><div class="nav">CampusCare | Welcome <%=session.getAttribute("studentName")%></div><div class="wrap"><a class="btn" href="raise-complaint.jsp">Raise Complaint</a><%if(request.getParameter("success")!=null){%><p>Complaint submitted successfully.</p><%}%><h2>My Complaints</h2><%for(Complaint c:list){%><div class="card"><h3>#<%=c.getComplaintId()%> - <%=c.getTitle()%></h3><p>Category: <%=c.getCategoryName()%></p><p><%=c.getDescription()%></p><p>Status: <b><%=c.getStatus()%></b></p><p>Remarks: <%=c.getRemarks()==null?"-":c.getRemarks()%></p></div><%}%></div></body></html>